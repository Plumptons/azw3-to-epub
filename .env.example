# Shared media tree (same host bind Bindery + Storyteller use)
MEDIA_DIR=M:/media

# --- Safety defaults (reference contracts) ---
# DELETE_SOURCE=false — never auto-delete AZW3 after convert unless you opt in.
# Bindery queue clear always uses deleteFiles=false (no download/library deletes).
# scripts/check_bindery_files_on_disk.py is report-only unless you pass --fix
#   (--fix unlinks Bindery catalogue paths only; never deletes library files).
DELETE_SOURCE=false
# Log coalesce moves/unlinks without changing the filesystem.
FOLDER_COALESCE_DRY_RUN=false

INITIAL_SCAN=true
# Full-tree AZW3 poll (Docker/Windows mounts often miss watchdog events)
RESCAN_INTERVAL=120
STABLE_SECONDS=5
LOG_LEVEL=INFO
TZ=Pacific/Auckland
PUID=0
PGID=0

# --- Bindery (Docker DNS on the main compose network) ---
# Prefer http://bindery:8787 when this service shares the media-PC compose network.
# LAN host:port is a fallback for one-off scripts run off-box only.
BINDERY_URL=http://bindery:8787
BINDERY_API_KEY=
BINDERY_SYNC=true
BINDERY_LIBRARY_DIR=/media/books
# Opt-in Bindery helpers (off — leave search/queue/audio to Bindery itself)
BINDERY_WANTED_SEARCH=false
BINDERY_SEARCH_INTERVAL=3600
# Remove failed/imported Bindery queue rows (never passes deleteFiles).
BINDERY_CLEAR_QUEUE=false
BINDERY_CLEAR_QUEUE_INTERVAL=300
# Probe ebook-only books for audiobook releases; set both or demote to ebook.
BINDERY_AUDIO_PROBE=false
BINDERY_AUDIO_PROBE_INTERVAL=3600
BINDERY_AUDIO_PROBE_LIMIT=5
BINDERY_AUDIO_PROBE_COOLDOWN=604800
# Merge Bindery "Title (Year) (2)" sibling folders into the primary folder
FOLDER_COALESCE=true
FOLDER_COALESCE_INTERVAL=300

# --- Storyteller (Docker DNS on the main compose network) ---
# Same Docker network: container port 8001 (host maps 8886:8001)
# Off-box fallback only: http://<media-pc-lan>:8886
STORYTELLER_URL=http://storyteller:8001
STORYTELLER_USERNAME=
STORYTELLER_PASSWORD=
STORYTELLER_AUTO_MERGE=true
# Seconds between full library merge sweeps (also runs after each convert)
STORYTELLER_MERGE_INTERVAL=300
# Wait after convert so Storyteller auto-import can see the new EPUB
STORYTELLER_MERGE_DELAY=15
# Queue readaloud alignment for books that already have ebook + audiobook
STORYTELLER_AUTO_READALOUD=true
# Local-time window only (uses container TZ, e.g. Pacific/Auckland)
STORYTELLER_READALOUD_START=00:01
STORYTELLER_READALOUD_END=06:00
STORYTELLER_READALOUD_INTERVAL=1800
# Max books allowed in progress at once (alignment is GPU-heavy)
STORYTELLER_READALOUD_LIMIT=1
# Assign Storyteller series (with Bindery reading order) for imported books
STORYTELLER_SYNC_SERIES=true
STORYTELLER_SERIES_INTERVAL=3600

# --- Jellyfin (optional: pause Storyteller readaloud while anyone is watching) ---
# Same Docker network: http://jellyfin:8096 (adjust service name/port if needed)
# Create an API key in Jellyfin Dashboard → API Keys
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
# When URL+key are set, default is on — skips/stops readaloud during playback
JELLYFIN_PAUSE_READALOUD=true
# How often to poll Sessions during the night window (seconds)
JELLYFIN_PLAYBACK_CHECK_INTERVAL=60
# Optional: only these Jellyfin usernames block readaloud (comma-separated)
# JELLYFIN_USER_NAMES=
# Count paused NowPlaying as "playing" too (default: only unpaused)
# JELLYFIN_TREAT_PAUSED_AS_PLAYING=false

# --- Watched cleanup (opt-in): delete watched episode/movie files + unmonitor ---
# Does NOT unmonitor the whole series — only the watched episode / movie.
# Requires Jellyfin + Sonarr and/or Radarr API access on the same Docker network.
WATCHED_CLEANUP=false
# Stay true until you have reviewed dry-run logs.
WATCHED_CLEANUP_DRY_RUN=true
WATCHED_CLEANUP_INTERVAL=3600
# Only act after LastPlayedDate is at least this old (hours)
WATCHED_CLEANUP_GRACE_HOURS=24
WATCHED_CLEANUP_TYPES=Episode,Movie
# Optional: limit to these Jellyfin usernames (defaults to JELLYFIN_USER_NAMES)
# WATCHED_CLEANUP_USER_NAMES=
# Optional path rewrite if Jellyfin and *arr see different roots:
# WATCHED_CLEANUP_PATH_FROM=/data
# WATCHED_CLEANUP_PATH_TO=/media
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=
RADARR_URL=http://radarr:7878
RADARR_API_KEY=

# Calibre output: 2 (widest compatibility) or 3 (better for Storyteller)
EPUB_VERSION=3

# --- Media-PC Storyteller service (not consumed by this container) ---
# Keep STORYTELLER_SECRET_KEY in the main compose .env for the storyteller
# service itself. Never commit the real value; rotate if it was ever pasted.
# STORYTELLER_SECRET_KEY=
